                <zone fixed-size='241' h='26214' id='11' is-fixed='true' name='Top paises exportadores' w='33008' x='625' y='54523'>
                  <layout-cache minwidth='252' type-h='fixed' type-w='scalable' />
                  <zone-style>
                    <format attr='border-color' value='#000000' />
