    <worksheet name='Dot plot aracel por tier'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book' italic='true'>Aranceles por tier de paises exportadores</run>
            <run>Æ&#10;</run>
            <run fontname='Benton Sans Book' fontsize='8' italic='true'>Dot plot — AHS: arancel efectivo ponderado tras acuerdos comerciales. Ref. promedio global: 3.72% </run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
