          <datasource-dependencies datasource='federated.0ljxpiw0h3zsu61h4vf4g1xnetyi'>
            <column caption='Export YoY % All' datatype='real' name='[Calculation_1007444570238976]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Export (US$ Million)]) - LOOKUP(SUM([Export (US$ Million)]), -1))&#13;&#10;/ ABS(LOOKUP(SUM([Export (US$ Million)]), -1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column datatype='real' name='[Export (US$ Million)]' role='measure' type='quantitative' />
