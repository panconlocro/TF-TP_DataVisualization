    <worksheet name='KPI %Deficit'>
      <table>
        <view>
          <datasources>
            <datasource caption='Dim_Country+' name='federated.0ljxpiw0h3zsu61h4vf4g1xnetyi' />
          </datasources>
          <datasource-dependencies datasource='federated.0ljxpiw0h3zsu61h4vf4g1xnetyi'>
            <column caption='Deficit Comercial' datatype='real' name='[Calculation_0377978919620608]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Trade Balance (US$ Million)] &lt; 0 THEN ABS([Trade Balance (US$ Million)]) ELSE 0 END' />
            </column>
            <column caption='% Déficit en Top 5' datatype='real' default-format='p0.0%' name='[Calculation_0377978920218625]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Top 5 Importadores Netos] THEN [Calculation_0377978919620608] END) &#13;&#10;/ &#13;&#10;SUM([Calculation_0377978919620608])' />
            </column>
            <column caption='Filtro Año' datatype='integer' name='[Calculation_0377978926571525]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='LOOKUP(ATTR([Year]), 0)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column datatype='string' name='[Partner Name]' role='dimension' semantic-role='[Country].[Name]' type='nominal' />
            <column datatype='real' name='[Trade Balance (US$ Million)]' role='measure' type='quantitative' />
            <column datatype='integer' name='[Year]' role='dimension' type='quantitative' />
            <column-instance column='[Calculation_0377978920218625]' derivation='User' name='[diff:usr:Calculation_0377978920218625:qk:2]' pivot='key' type='quantitative'>
              <table-calc diff-options='Relative' ordering-field='[federated.0ljxpiw0h3zsu61h4vf4g1xnetyi].[Year]' ordering-type='Field' type='Difference'>
                <address>
                  <value>-1</value>
                </address>
              </table-calc>
            </column-instance>
            <column-instance column='[Year]' derivation='None' name='[none:Year:ok]' pivot='key' type='ordinal' />
