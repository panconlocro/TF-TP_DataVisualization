      <aliases enabled='yes' />
      <column caption='Deficit Comercial' datatype='real' name='[Calculation_0377978919620608]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Trade Balance (US$ Million)] &lt; 0 THEN ABS([Trade Balance (US$ Million)]) ELSE 0 END' />
      </column>
      <column caption='% Déficit en Top 5' datatype='real' default-format='p0.0%' name='[Calculation_0377978920218625]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Top 5 Importadores Netos] THEN [Calculation_0377978919620608] END) &#13;&#10;/ &#13;&#10;SUM([Calculation_0377978919620608])' />
      </column>
      <column caption='Filtro Año' datatype='integer' name='[Calculation_0377978926571525]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='LOOKUP(ATTR([Year]), 0)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Alerta de Balance' datatype='string' name='[Calculation_0377978935865350]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Trade Balance (US$ Million)]) &lt; 0 THEN &quot;Déficit&quot;&#13;&#10;ELSE &quot;Superávit&quot; END' />
      </column>
      <column caption='Export MA3' datatype='real' name='[Calculation_0414807727398912]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_AVG(SUM([Export (US$ Million)]), -2, 0)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Concentracion Tier 1%' datatype='real' name='[Calculation_0414807727583233]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF CONTAINS([Export_Tier], &quot;Tier 1&quot;) THEN [Export (US$ Million)] END)&#13;&#10;/ SUM([Export (US$ Million)])' />
      </column>
      <column caption='Export YoY %' datatype='real' name='[Calculation_0414807731449859]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='( [Calculation_0414807783211024] - [Calculation_0414807783276561] ) / [Calculation_0414807783276561]' />
      </column>
      <column caption='Global_Export_Year' datatype='real' name='[Calculation_0414807731552260]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Year] : SUM([Export (US$ Million)]) }' />
      </column>
      <column caption='Export Share %' datatype='real' name='[Calculation_0414807731785733]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Export (US$ Million)]) / SUM([Calculation_0414807731552260])' />
      </column>
      <column caption='Pct Paises Superavit' datatype='real' name='[Calculation_0414807732015110]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [Trade Status] = &quot;Superavit&quot; THEN [Partner Name] END)&#13;&#10;/ COUNTD([Partner Name])' />
      </column>
      <column caption='Estado Crecimiento' datatype='string' name='[Calculation_0414807732092935]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0414807731449859] &gt;= 0 THEN &quot;Verde&quot; ELSE &quot;Rojo&quot; END' />
      </column>
      <column caption='Estado Balance' datatype='string' name='[Calculation_0414807732170760]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Trade Balance (US$ Million)]) &gt;= 0 THEN &quot;Verde&quot; ELSE &quot;Rojo&quot; END' />
      </column>
      <column caption='Icono Estado' datatype='string' name='[Calculation_0414807732219913]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0414807731449859] &gt;= 0 THEN &quot;▲&quot; ELSE &quot;▼&quot; END' />
      </column>
      <column caption='Periodo' datatype='string' name='[Calculation_0414807732260874]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Year] &lt;= 1995 THEN &quot;1988-1995&quot;&#13;&#10;ELSEIF [Year] &lt;= 2003 THEN &quot;1996-2003&quot;&#13;&#10;ELSEIF [Year] &lt;= 2011 THEN &quot;2004-2011&quot;&#13;&#10;ELSE &quot;2012-2021&quot; END' />
      </column>
      <column caption='Color Promedio' datatype='string' name='[Calculation_0414807775232014]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Export (US$ Million)]) &gt;&#13;&#10;WINDOW_AVG(SUM([Export (US$ Million)]))&#13;&#10;THEN&#13;&#10;    &quot;Sobre promedio&quot;&#13;&#10;ELSE&#13;&#10;    &quot;Bajo promedio&quot;&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Año más reciente' datatype='integer' name='[Calculation_0414807783063567]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : MAX([Year]) }' />
      </column>
      <column caption='Export año actual' datatype='real' name='[Calculation_0414807783211024]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM( IF [Year] = [Calculation_0414807783063567] THEN [Export (US$ Million)] END )' />
      </column>
      <column caption='Export año previo' datatype='real' name='[Calculation_0414807783276561]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM( IF [Year] = [Calculation_0414807783063567] - 1 THEN [Export (US$ Million)] END )' />
      </column>
      <column caption='Export Tier1 año actual' datatype='real' name='[Calculation_0414807788150802]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM( IF [Year] = [Calculation_0414807783063567] AND CONTAINS([Export_Tier],&quot;Tier 1&quot;)&#13;&#10;     THEN [Export (US$ Million)] END )' />
      </column>
      <column caption='Concentración Tier 1' datatype='real' name='[Calculation_0414807788245011]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0414807788150802] / [Calculation_0414807783211024]' />
      </column>
      <column caption='Balance año actual' datatype='real' name='[Calculation_0414807789338644]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM( IF [Year] = [Calculation_0414807783063567] THEN [Trade Balance (US$ Million)] END )' />
      </column>
      <column caption='Países superávit año actual' datatype='integer' name='[Calculation_0414807789412373]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD( IF [Year] = [Calculation_0414807783063567] AND [Trade Status] = &quot;Superavit&quot; THEN [Partner Name] END )' />
      </column>
      <column caption='Países total año actual' datatype='integer' name='[Calculation_0414807789465622]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD( IF [Year] = [Calculation_0414807783063567] THEN [Partner Name] END )' />
      </column>
      <column caption='% superávit año actual' datatype='real' name='[Calculation_0414807789522967]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0414807789412373] / [Calculation_0414807789465622]' />
      </column>
      <column caption='Arancel AHS año actual' datatype='real' name='[Calculation_0414807791853592]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG( IF [Year] = [Calculation_0414807783063567] THEN [AHS Weighted Average (%)] END )' />
      </column>
      <column caption='Arancel AHS año previo' datatype='real' name='[Calculation_0414807791955993]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG( IF [Year] = [Calculation_0414807783063567] - 1 THEN [AHS Weighted Average (%)] END )' />
      </column>
      <column caption='Variación arancel (pts)' datatype='real' name='[Calculation_0414807792046106]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0414807791853592] - [Calculation_0414807791955993]' />
      </column>
      <column caption='Export YoY % All' datatype='real' name='[Calculation_1007444570238976]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Export (US$ Million)]) - LOOKUP(SUM([Export (US$ Million)]), -1))&#13;&#10;/ ABS(LOOKUP(SUM([Export (US$ Million)]), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Average Color' datatype='boolean' name='[Calculation_1007444604481537]' role='measure' type='nominal'>
        <calculation class='tableau' formula='AVG([AHS Weighted Average (%)]) &gt; TOTAL(AVG([AHS Weighted Average (%)]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
